Vagrant.configure("2") do |config|
  config.vm.box = "gusztavvargadr/windows-10"

  config.vm.network "private_network",
    ip: "192.168.56.21",
    virtualbox__intnet: "cyber-lab"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 4096
    vb.cpus = 2
  end

  config.vm.provision "shell",
    inline: "if (Get-NetFirewallRule -DisplayName 'Allow Lab ICMPv4' -ErrorAction SilentlyContinue) { Set-NetFirewallRule -DisplayName 'Allow Lab ICMPv4' -Enabled True -Direction Inbound -Action Allow -Profile Any; Get-NetFirewallRule -DisplayName 'Allow Lab ICMPv4' | Get-NetFirewallPortFilter | Out-Null } else { New-NetFirewallRule -DisplayName 'Allow Lab ICMPv4' -Protocol ICMPv4 -IcmpType 8 -Direction Inbound -Action Allow -Profile Any -RemoteAddress 192.168.56.10 }",
    privileged: true
end