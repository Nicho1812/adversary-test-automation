
Vagrant.configure("2") do |config|
  marker = File.join(__dir__, ".nat-disabled")
  isolated = File.exist?(marker)

  config.vm.box = "gusztavvargadr/windows-10"

  if isolated
    config.winrm.host = "192.168.57.21"
    config.winrm.port = 5985
  else
    config.vm.network "forwarded_port",
      guest: 5985, host: 55985, id: "winrm",
      auto_correct: true
  end

  config.vm.network "private_network",
    ip: "192.168.56.21",
    virtualbox__intnet: "cyber-lab",
    auto_config: false

  config.vm.network "private_network",
    ip: "192.168.57.21",
    virtualbox__hostonly: true,
    auto_config: false

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 4096
    vb.cpus = 2
    vb.customize ["modifyvm", :id, "--macaddress1", "08002729B0AD"]
    vb.customize ["modifyvm", :id, "--macaddress2", "080027CCF120"]
    vb.customize ["modifyvm", :id, "--macaddress3", "0800277E2D5D"]
    vb.customize ["modifyvm", :id, "--nic1", isolated ? "none" : "nat"]
  end

  config.vm.provision "shell",
    privileged: true,
    run: "always",
    inline: <<-POWERSHELL
$ErrorActionPreference = "Stop"
$labMac = "08-00-27-CC-F1-20"
$mgmtMac = "08-00-27-7E-2D-5D"

$lab = Get-NetAdapter | Where-Object { $_.MacAddress -eq $labMac }
$mgmt = Get-NetAdapter | Where-Object { $_.MacAddress -eq $mgmtMac }

if (-not $lab -or -not $mgmt) {
  throw "Lab or management adapter not found."
}

foreach ($entry in @(
  @{ InterfaceIndex = $lab.ifIndex; IP = "192.168.56.21" },
  @{ InterfaceIndex = $mgmt.ifIndex; IP = "192.168.57.21" }
)) {
  Set-NetIPInterface -InterfaceIndex $entry.InterfaceIndex -AddressFamily IPv4 -Dhcp Disabled

  $existing = Get-NetIPAddress -InterfaceIndex $entry.InterfaceIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue |
    Where-Object { $_.IPAddress -eq $entry.IP }

  if (-not $existing) {
    Get-NetIPAddress -InterfaceIndex $entry.InterfaceIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue |
      Where-Object { $_.IPAddress -ne "127.0.0.1" } |
      Remove-NetIPAddress -Confirm:$false -ErrorAction SilentlyContinue

    New-NetIPAddress -InterfaceIndex $entry.InterfaceIndex -IPAddress $entry.IP -PrefixLength 24
  }
}

if (-not (Get-NetFirewallRule -DisplayName "Allow Lab ICMPv4" -ErrorAction SilentlyContinue)) {
  New-NetFirewallRule -DisplayName "Allow Lab ICMPv4" -Protocol ICMPv4 -IcmpType 8 -Direction Inbound -Action Allow -Profile Any -RemoteAddress "192.168.56.10"
}
POWERSHELL
end
