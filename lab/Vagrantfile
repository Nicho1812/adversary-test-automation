
Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.network "forwarded_port",
    guest: 22,
    host: 2222,
    id: "ssh",
    disabled: true

  # Connect Vagrant through the host-only management network
  config.ssh.host = "192.168.57.10"
  config.ssh.port = 22

  # Isolated lab network: Ubuntu to Windows
  config.vm.network "private_network",
    ip: "192.168.56.10",
    virtualbox__intnet: "cyber-lab"

  # Host-only management network
  config.vm.network "private_network",
    ip: "192.168.57.10",
    virtualbox__hostonly: true

  # Disable NAT
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 2048
    vb.cpus = 2
    vb.customize ["modifyvm", :id, "--nic1", "none"]
  end

  # Persist network configuration for Ubuntu boot
  config.vm.provision "shell",
    privileged: true,
    inline: <<-SHELL
cat > /etc/netplan/99-vagrant-lab.yaml <<'EOF'
network:
  version: 2
  ethernets:
    enp0s8:
      dhcp4: false
      addresses:
        - 192.168.56.10/24
    enp0s9:
      dhcp4: false
      addresses:
        - 192.168.57.10/24
EOF

chmod 600 /etc/netplan/99-vagrant-lab.yaml
chmod 600 /etc/netplan/50-vagrant.yaml
netplan generate
netplan apply
SHELL
end
